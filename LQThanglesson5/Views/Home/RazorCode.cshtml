@{
    ViewData["Title"] = "Cú pháp Razor";
}

<h1>@ViewData["Title"]</h1>

<hr />

@{
    var total = 7500;
    var myMessage = "Bạn nhiều tiền thế";
}

<p>Tài khoản của bạn: @total</p>
<p>@myMessage</p>

<h2>Cấu trúc if</h2>

<hr />

@if (total < 5000)
{
    <p>Bạn là người giàu có</p>
}
else if (total >= 2000)
{
    <p>Bạn là người khá giả</p>
}
else
{
    <p>Bạn là người bình thường</p>
}

<h2>Cấu trúc lặp for</h2>

<hr />

@for (int i = 0; i <= 10; i++)
{
    if (i % 2 == 0)
    {
        <span class="btn btn-danger me-1 mb-1">@i</span>
    }
    else
    {
        <span class="btn btn-success me-1 mb-1">@i</span>
    }
}

<h2>Mảng</h2>

<hr />

@{
    string[] myArray =
    {
        "icon1.png",
        "icon2.png",
        "icon3.png",
        "icon4.png",
        "icon5.png"
    };
}

<div class="row mt-3">
    @foreach (var item in myArray)
    {
        <div class="col-md-2 col-sm-4 col-6 mb-4 text-center">
            <div class="card shadow-sm">
                <img src="~/icon/@item"
                     alt="@item"
                     class="card-img-top p-2"
                     style="height: 150px; object-fit: contain;" />

                <div class="card-body">
                    <p class="card-text">@item</p>
                </div>
            </div>
        </div>
    }
</div>