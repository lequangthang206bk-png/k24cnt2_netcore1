@model LqtLesson08Models.Models.LqtMember

@{
    ViewData["Title"] = "Sửa thông tin thành viên";
}

<form asp-action="LqtEdit" method="post">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h3 class="mb-0 text-primary">@ViewData["Title"]</h3>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="LqtMemberId" />
                    
                    <div class="form-group mb-3">
                        <label asp-for="LqtUserName" class="form-label fw-bold"></label>
                        <input asp-for="LqtUserName" class="form-control" />
                        <span asp-validation-for="LqtUserName" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="LqtPassword" class="form-label fw-bold"></label>
                        <input asp-for="LqtPassword" class="form-control" />
                        <span asp-validation-for="LqtPassword" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="LqtFullName" class="form-label fw-bold"></label>
                        <input asp-for="LqtFullName" class="form-control" />
                        <span asp-validation-for="LqtFullName" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="LqtEmail" class="form-label fw-bold"></label>
                        <input asp-for="LqtEmail" class="form-control" />
                        <span asp-validation-for="LqtEmail" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer bg-white border-top-0 pb-3">
            <input type="submit" value="Cập nhật" class="btn btn-primary" />
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </div>
    </div>
</form>
