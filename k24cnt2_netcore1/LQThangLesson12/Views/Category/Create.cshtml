@model LQThangLesson12.Models.Product

@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<h1>Thêm sản phẩm</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label">
                    Tên sản phẩm
                </label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Image">
                    Ảnh
                </label>

                <input asp-for="Image"
                       class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Price">
                    Price
                </label>

                <input asp-for="Price"
                       class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="SalePrice">
                    SalePrice
                </label>

                <input asp-for="SalePrice"
                       class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Status">
                    Status
                </label>

                <input asp-for="Status"
                       class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Descriptions">
                    Descriptions
                </label>

                <textarea asp-for="Descriptions"
                          class="form-control">
                </textarea>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CategoryId">
                    Category
                </label>

                <select asp-for="CategoryId"
                        class="form-control">

                    <option value="">
                        -- Chọn Category --
                    </option>

                    @foreach (var category in ViewBag.Categories)
                    {
                        <option value="@category.Id">
                            @category.Name
                        </option>
                    }

                </select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CreatedDate">
                    CreatedDate
                </label>

                <input asp-for="CreatedDate"
                       type="datetime-local"
                       class="form-control" />
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Thêm sản phẩm
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Quay lại
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}