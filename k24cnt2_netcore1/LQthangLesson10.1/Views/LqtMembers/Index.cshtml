@model IEnumerable<LQthangLesson10._1.Models.LqtMember>

@{
    ViewData["Title"] = "Index";
}


    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

    <thead>
        <tr>
            <th>Id</th>
            <th>User Name</th>
            <th>Full Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
    <tr>
        <td>@item.Id</td>
        <td>@item.LqtUserName</td>
        <td>@item.LqtFullName</td>
        <td>@item.LqtEmail</td>
        <td>@item.LqtPhone</td>
        <td>@(item.LqtStatus == true ? "Active" : "Inactive")</td>
        <td>
            <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
            <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
            <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
        </td>
    </tr>
}
    </tbody>
</table>
