@model LQthangLesson10._1.Models.LqtMember

@{
    ViewData["Title"] = "Details";
}


    <h4>LqtMember</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.Id</dd>

        <dt class="col-sm-2">User Name</dt>
        <dd class="col-sm-10">@Model.LqtUserName</dd>

        <dt class="col-sm-2">Full Name</dt>
        <dd class="col-sm-10">@Model.LqtFullName</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.LqtEmail</dd>

        <dt class="col-sm-2">Phone</dt>
        <dd class="col-sm-10">@Model.LqtPhone</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@(Model.LqtStatus == true ? "Active" : "Inactive")</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
