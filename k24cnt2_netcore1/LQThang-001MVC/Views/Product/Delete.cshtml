@model LQThang_001MVC.Models.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<div class="container mt-4">

    <h1 class="text-danger mb-4">
        Xóa sản phẩm
    </h1>


    <div class="alert alert-warning">

        Bạn có chắc chắn muốn xóa:

        <strong>
            @Model.Name
        </strong>

        ?

    </div>


    <div class="card mb-4">

        <div class="card-body">

            <p>
                <strong>ID:</strong>
                @Model.Id
            </p>

            <p>
                <strong>Tên:</strong>
                @Model.Name
            </p>

            <p>
                <strong>Hãng:</strong>
                @Model.Brand
            </p>

            <p>
                <strong>Giá:</strong>
                @Model.Price.ToString("N0") VNĐ
            </p>

            <p>
                <strong>Số lượng:</strong>
                @Model.Quantity
            </p>

        </div>

    </div>


    <form asp-controller="Product"
          asp-action="DeleteConfirmed"
          method="post">

        <input type="hidden"
               name="id"
               value="@Model.Id" />


        <button type="submit"
                class="btn btn-danger">

            Xác nhận xóa

        </button>


        <a asp-controller="Product"
           asp-action="Index"
           class="btn btn-secondary">

            Hủy

        </a>

    </form>

</div>