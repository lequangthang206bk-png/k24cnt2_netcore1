@model List<Product>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Quản lý sản phẩm</h2>
        <p class="text-muted mb-0"></p>
    </div>
    <a class="btn btn-dark" asp-action="Create">+ Thêm sản phẩm</a>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-6">
        <input class="form-control" name="keyword" value="@ViewBag.Keyword" placeholder="Tìm theo tên hoặc nhóm sản phẩm..." />
    </div>
    <div class="col-auto"><button class="btn btn-outline-dark">Tìm kiếm</button></div>
</form>

<div class="product-management-card table-responsive">
<table class="table product-management-table align-middle bg-white">
<thead class="table-light">
<tr><th>Ảnh</th><th>Tên</th><th>Nhóm</th><th>Giá</th><th>Tồn kho</th><th width="190">Thao tác</th></tr>
</thead>
<tbody>
@foreach (var p in Model)
{
<tr>
<td><img src="@p.ImageUrl" class="table-img" /></td>
<td>@p.Name</td><td>@p.Category</td><td>@p.Price.ToString("N0") đ</td><td>@p.Quantity</td>
<td>
<a class="btn btn-sm btn-outline-primary" asp-controller="Home" asp-action="Details" asp-route-id="@p.Id">Xem</a>
<a class="btn btn-sm btn-outline-warning" asp-action="Edit" asp-route-id="@p.Id">Sửa</a>
<a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@p.Id">Xóa</a>
</td>
</tr>
}
</tbody>
</table>
</div>
