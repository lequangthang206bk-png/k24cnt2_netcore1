@model Product
@{
    ViewData["Title"] = "Sửa sản phẩm";
}
<h2>Sửa sản phẩm</h2>
<form asp-action="Edit" method="post" class="form-card">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <partial name="_ProductForm" model="Model" />
    <button class="btn btn-dark">Cập nhật</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
</form>
