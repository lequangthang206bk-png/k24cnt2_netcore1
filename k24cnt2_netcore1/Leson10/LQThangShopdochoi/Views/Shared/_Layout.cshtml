<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShopDoChoi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<header class="site-header">
    <div class="top-strip">
        <div class="container top-strip-inner">
            <span>🎁 Đồ chơi chính hãng · Giá tốt mỗi ngày</span>
            <span>☎ Hỗ trợ: 0287 777 0049</span>
        </div>
    </div>
    <nav class="navbar navbar-expand-lg main-nav">
        <div class="container">
            <a class="navbar-brand brand-mark" asp-controller="Home" asp-action="Index">
                <span class="brand-icon">🧸</span>
                <span><strong>Shop</strong>DoChoi<small>Discovering Fun Toys</small></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div id="menu" class="collapse navbar-collapse">
                <form asp-controller="Home" asp-action="Index" method="get" class="header-search mx-lg-4 my-3 my-lg-0">
                    <span>⌕</span>
                    <input name="keyword" value="@Context.Request.Query["keyword"]" placeholder="Tìm kiếm đồ chơi, mô hình, LEGO..." />
                    <button type="submit">Tìm</button>
                </form>
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Product" asp-action="Index">Sản phẩm</a></li>
                    <li class="nav-item"><a class="nav-link cart-link" asp-controller="Cart" asp-action="Index">🛒 Giỏ hàng</a></li>
                </ul>
            </div>
        </div>
    </nav>
</header>

<main class="container py-4">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success shadow-sm">@TempData["Message"]</div>
    }
    @RenderBody()
</main>

<footer class="site-footer mt-5">
    <div class="container py-4 d-flex flex-column flex-md-row justify-content-between gap-3">
        <div><strong>ShopDoChoi</strong><div>Thế giới đồ chơi vui nhộn và sáng tạo.</div></div>
        <div>☎ 0287 777 0049 · © 2026 ShopDoChoi</div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
