@model Product
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}
<div class="row g-5">
    <div class="col-md-6">
        <img src="@Model.ImageUrl" class="img-fluid rounded-4 detail-img" alt="@Model.Name" />
    </div>
    <div class="col-md-6">
        <span class="badge text-bg-light mb-2">@Model.Category</span>
        <h1>@Model.Name</h1>
        <h2 class="price">@Model.Price.ToString("N0") đ</h2>
        <p class="text-muted">Số lượng còn: @Model.Quantity</p>
        <p>@Model.Description</p>
        <form asp-controller="Cart" asp-action="Add" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button class="btn btn-dark btn-lg" @(Model.Quantity <= 0 ? "disabled" : "")>🛒 Thêm vào giỏ hàng</button>
            <a class="btn btn-outline-secondary btn-lg" asp-action="Index">Quay lại</a>
        </form>
    </div>
</div>
