@model IEnumerable<LqtLesson08Models.Models.LqtMember>

@{
    ViewData["Title"] = "Danh sách thành viên";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h3 class="mb-0 text-primary fw-bold">@ViewData["Title"]</h3> 
        <a asp-action="LqtCreate" class="btn btn-success">+ Thêm mới</a>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.LqtMemberId)</th>
                        <th>@Html.DisplayNameFor(model => model.LqtUserName)</th>
                        <th>@Html.DisplayNameFor(model => model.LqtPassword)</th>
                        <th>@Html.DisplayNameFor(model => model.LqtFullName)</th>
                        <th>@Html.DisplayNameFor(model => model.LqtEmail)</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.LqtMemberId)</td>
                        <td>@Html.DisplayFor(modelItem => item.LqtUserName)</td>
                        <td>••••••••</td>
                        <td>@Html.DisplayFor(modelItem => item.LqtFullName)</td>
                        <td>@Html.DisplayFor(modelItem => item.LqtEmail)</td>
                        <td class="text-center">
                            <a asp-action="LqtEdit" asp-route-id="@item.LqtMemberId" class="btn btn-sm btn-outline-warning">Sửa</a>
                            <a asp-action="LqtDetails" asp-route-id="@item.LqtMemberId" class="btn btn-sm btn-outline-info">Chi tiết</a>
                            <a asp-action="LqtDelete" asp-route-id="@item.LqtMemberId" class="btn btn-sm btn-outline-danger">Xóa</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
