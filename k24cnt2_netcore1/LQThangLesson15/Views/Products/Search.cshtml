@model IEnumerable<LQThangLesson15.Models.LqtProduct>
@{
    ViewData["Title"] = "Tìm kiếm sản phẩm";
    var keyword = ViewData["ProductId"] as string;
}

<section class="page-heading">
    <span class="eyebrow">QUERYSTRING + SQL SERVER</span>
    <h1>Tìm kiếm sản phẩm</h1>
    <p>Tham số keyword đi qua QueryString và được dùng để lọc dữ liệu SQL Server.</p>
</section>

<form class="search-panel" asp-controller="Products" asp-action="Search" method="get">
    <input name="keyword" value="@keyword" placeholder="Nhập tên hoặc danh mục..." />
    <button type="submit">Tìm kiếm</button>
</form>

@if (!string.IsNullOrWhiteSpace(keyword))
{
    <div class="search-info">Kết quả cho: <strong>@keyword</strong></div>
}

<div class="product-grid">
@foreach (var product in Model)
{
    <article class="product-card">
        <div class="product-image"><img src="@product.ImageUrl" alt="@product.Name" /></div>
        <div class="product-content">
            <span class="category">@product.Category</span>
            <h3>@product.Name</h3>
            <p>@product.Description</p>
            <div class="product-footer"><strong>@product.Price.ToString("N0") đ</strong><span>SQL Server</span></div>
        </div>
    </article>
}
</div>
