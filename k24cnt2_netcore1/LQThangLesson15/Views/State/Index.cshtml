@{
    ViewData["Title"] = "Quản lý trạng thái";
}

<section class="page-heading">
    <span class="eyebrow">STATE MANAGEMENT</span>
    <h1>Client-side và Server-side State</h1>
    <p>Chọn từng kỹ thuật để xem cách lưu, truyền và sử dụng dữ liệu trong ASP.NET Core.</p>
</section>

<div class="state-dashboard">
    <div class="state-demo-card">
        <div class="demo-icon">01</div>
        <div><span class="card-label">CLIENT-SIDE</span><h3>Cookies</h3><p>Lưu tên người dùng trên trình duyệt.</p></div>
        <a class="btn-small" asp-action="Cookie">Thực hành</a>
    </div>
    <div class="state-demo-card">
        <div class="demo-icon">02</div>
        <div><span class="card-label">SERVER-SIDE</span><h3>Session</h3><p>Đếm số lần truy cập theo phiên.</p></div>
        <div class="value-box">@ViewBag.SessionCount</div>
        <form asp-action="SessionValue" method="post">@Html.AntiForgeryToken()<button class="btn-small" type="submit">Tăng Session</button></form>
    </div>
    <div class="state-demo-card">
        <div class="demo-icon">03</div>
        <div><span class="card-label">REQUEST TO REQUEST</span><h3>TempData</h3><p>Truyền thông báo sang request tiếp theo.</p></div>
        <a class="btn-small" asp-action="TempDataValue">Chạy thử</a>
    </div>
    <div class="state-demo-card">
        <div class="demo-icon">04</div>
        <div><span class="card-label">CLIENT-SIDE</span><h3>QueryString</h3><p>Truyền dữ liệu bằng tham số trên URL.</p></div>
        <a class="btn-small" asp-action="QueryString" asp-route-keyword="LQT Store">Mở ví dụ</a>
    </div>
    <div class="state-demo-card">
        <div class="demo-icon">05</div>
        <div><span class="card-label">FORM STATE</span><h3>Hidden Fields</h3><p>Gửi dữ liệu ẩn cùng biểu mẫu.</p></div>
        <a class="btn-small" asp-action="HiddenField">Mở ví dụ</a>
    </div>
    <div class="state-demo-card">
        <div class="demo-icon">06</div>
        <div><span class="card-label">REQUEST-SCOPE</span><h3>HttpContext.Items</h3><p>Dữ liệu chỉ tồn tại trong request hiện tại.</p></div>
        <a class="btn-small" asp-action="ItemsCache">Mở ví dụ</a>
    </div>
    <div class="state-demo-card state-card-wide">
        <div class="demo-icon">07</div>
        <div><span class="card-label">SERVER-SIDE</span><h3>Cache</h3><p>Lưu dữ liệu trong bộ nhớ trong khoảng thời gian cấu hình để hạn chế xử lý lặp lại.</p></div>
        <a class="btn-small" asp-action="ItemsCache">Mở ví dụ</a>
    </div>
</div>

<section class="state-summary">
    <div><strong>HttpContext.Items</strong><span>@ViewBag.ItemValue</span></div>
    <div><strong>IMemoryCache</strong><span>@ViewBag.CacheValue</span></div>
</section>
