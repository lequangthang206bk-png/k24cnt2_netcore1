@model IEnumerable<LQThangLesson15.Models.LqtCategoryViewModel>
@{
    ViewData["Title"] = "Quản lý danh mục";
}
<section class="panel">
    <div class="panel-head"><h2>Danh mục sản phẩm</h2></div>
    <div class="table-responsive">
        <table class="admin-table">
            <thead><tr><th>Danh mục</th><th>Số sản phẩm</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr><td>@item.Name</td><td>@item.Count</td></tr>
            }
            </tbody>
        </table>
    </div>
</section>
