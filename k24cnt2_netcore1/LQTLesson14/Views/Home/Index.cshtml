@{
    ViewData["Title"] = "Trang chủ";
    Layout = "~/Views/Shared/_LQTLayoutHome.cshtml";
}

<div class="home-welcome">

    <div class="welcome-content">
        <span class="welcome-label">LQT STORE</span>

        <h1>
            Chào mừng bạn đến với
            <strong>LQT Store</strong>
        </h1>

        <p>
            Khám phá sản phẩm chất lượng với thiết kế hiện đại,
            thông tin rõ ràng và mức giá phù hợp.
        </p>

        <div class="welcome-buttons">
            <a asp-controller="Products"
               asp-action="Index"
               class="welcome-primary">
                Xem sản phẩm
            </a>

            <a asp-controller="Products"
               asp-action="Hots"
               class="welcome-secondary">
                🔥 Bán chạy
            </a>
        </div>
    </div>

    <div class="welcome-icon">
        🛍️
    </div>

</div>

<div class="home-title">
    <span>KHÁM PHÁ</span>
    <h2>Khám phá cửa hàng</h2>
    <p>Lựa chọn sản phẩm phù hợp với nhu cầu của bạn</p>
</div>

<div class="home-features">

    <a asp-controller="Products"
       asp-action="Index"
       class="feature-card">

        <div class="feature-icon">🛒</div>

        <div class="feature-content">
            <span class="feature-number">01</span>
            <h3>Danh sách sản phẩm</h3>
            <p>
                Xem toàn bộ sản phẩm đang được cung cấp tại cửa hàng.
            </p>
        </div>

        <div class="feature-link">
            Xem sản phẩm →
        </div>

    </a>

    <a asp-controller="Products"
       asp-action="Search"
       class="feature-card">

        <div class="feature-icon">🔍</div>

        <div class="feature-content">
            <span class="feature-number">02</span>
            <h3>Tìm kiếm sản phẩm</h3>
            <p>
                Tìm nhanh sản phẩm bạn đang quan tâm.
            </p>
        </div>

        <div class="feature-link">
            Tìm kiếm →
        </div>

    </a>

    <a asp-controller="Products"
       asp-action="Hots"
       class="feature-card">

        <div class="feature-icon">🔥</div>

        <div class="feature-content">
            <span class="feature-number">03</span>
            <h3>Sản phẩm bán chạy</h3>
            <p>
                Khám phá những sản phẩm nổi bật được nhiều người quan tâm.
            </p>
        </div>

        <div class="feature-link">
            Khám phá →
        </div>

    </a>

</div>

<div class="home-intro">

    <div class="intro-icon">
        ★
    </div>

    <div>
        <span>LQT STORE</span>
        <h2>Mua sắm đơn giản và thuận tiện</h2>
        <p>
            Cung cấp thông tin sản phẩm rõ ràng,
            giao diện trực quan và trải nghiệm sử dụng dễ dàng.
        </p>
    </div>

</div>