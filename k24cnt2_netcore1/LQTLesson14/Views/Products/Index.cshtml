@{
    ViewData["Title"] = "Danh sách sản phẩm";
    Layout = "~/Views/Shared/_LQTLayoutHome.cshtml";
}

<div class="page-title">
    <h1>🛍️ @ViewData["Title"]</h1>
    <p>Khám phá các sản phẩm nổi bật tại LQT Store</p>
</div>

<div class="product-grid">

    <div class="product-card">

        <div class="product-image">
            <img src="~/images/iphone15.jpg" alt="iPhone 15" />
        </div>

        <div class="product-content">
            <span class="product-category">Điện thoại</span>

            <h3>iPhone 15</h3>

            <p class="product-description">
                Điện thoại hiện đại với thiết kế đẹp, hiệu năng mạnh mẽ.
            </p>

            <div class="product-bottom">
                <span class="price">18.990.000 đ</span>
                <button class="btn-product">Xem sản phẩm</button>
            </div>
        </div>
    </div>

    <div class="product-card">

        <div class="product-image">
            <img src="~/images/s24.jpg" alt="Samsung Galaxy S24" />
        </div>

        <div class="product-content">
            <span class="product-category">Điện thoại</span>

            <h3>Samsung Galaxy S24</h3>

            <p class="product-description">
                Smartphone cao cấp với thiết kế sang trọng và hiệu năng vượt trội.
            </p>

            <div class="product-bottom">
                <span class="price">16.990.000 đ</span>
                <button class="btn-product">Xem sản phẩm</button>
            </div>
        </div>
    </div>

    <div class="product-card">

        <div class="product-image">
            <img src="~/images/xiaomi14.jpg" alt="Xiaomi 14" />
        </div>

        <div class="product-content">
            <span class="product-category">Điện thoại</span>

            <h3>Xiaomi 14</h3>

            <p class="product-description">
                Sản phẩm nổi bật với cấu hình mạnh và camera chất lượng cao.
            </p>

            <div class="product-bottom">
                <span class="price">14.990.000 đ</span>
                <button class="btn-product">Xem sản phẩm</button>
            </div>
        </div>
    </div>

    <div class="product-card">

        <div class="product-image">
            <img src="~/images/airpodspro2.jpg" alt="AirPods Pro 2" />
        </div>

        <div class="product-content">
            <span class="product-category">Phụ kiện</span>

            <h3>AirPods Pro 2</h3>

            <p class="product-description">
                Tai nghe không dây cao cấp với thiết kế nhỏ gọn và tiện lợi.
            </p>

            <div class="product-bottom">
                <span class="price">5.990.000 đ</span>
                <button class="btn-product">Xem sản phẩm</button>
            </div>
        </div>
    </div>

    <div class="product-card">

        <div class="product-image">
            <img src="~/images/anker737.jpg" alt="Anker 737" />
        </div>

        <div class="product-content">
            <span class="product-category">Phụ kiện</span>

            <h3>Anker 737</h3>

            <p class="product-description">
                Pin sạc dự phòng dung lượng cao, thiết kế hiện đại và tiện dụng.
            </p>

            <div class="product-bottom">
                <span class="price">1.200.000 đ</span>
                <button class="btn-product">Xem sản phẩm</button>
            </div>
        </div>
    </div>

    <div class="product-card">

        <div class="product-image">
            <img src="~/images/galaxybuds3.jpg" alt="Galaxy Buds 3" />
        </div>

        <div class="product-content">
            <span class="product-category">Tai nghe</span>

            <h3>Galaxy Buds 3</h3>

            <p class="product-description">
                Tai nghe Bluetooth hiện đại với âm thanh chất lượng cao.
            </p>

            <div class="product-bottom">
                <span class="price">1.500.000 đ</span>
                <button class="btn-product">Xem sản phẩm</button>
            </div>
        </div>
    </div>

</div>