<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - LQThang Phone</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/LQThang_001MVC.styles.css"
          asp-append-version="true" />

</head>

<body>

    <!-- HEADER -->

    <header>

        <nav class="navbar navbar-expand-sm navbar-dark bg-dark shadow">

            <div class="container">

                <!-- LOGO -->

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">

                    📱 LQTHANG PHONE

                </a>


                <!-- MOBILE MENU -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- MENU -->

                <div class="navbar-collapse collapse d-sm-inline-flex">

                    <ul class="navbar-nav">

                        <!-- HOME -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                🏠 Trang chủ

                            </a>

                        </li>


                        <!-- PRODUCT -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Product"
                               asp-action="Index">

                                📱 Sản phẩm

                            </a>

                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- CONTENT -->

    <div class="container">

        <main role="main"
              class="pb-3">

            @RenderBody()

        </main>

    </div>


    <!-- FOOTER -->

    <footer class="border-top bg-dark text-white mt-5">

        <div class="container py-3 text-center">

            © 2026 - LQTHANG PHONE

            <span class="mx-2">|</span>

            Cửa hàng điện thoại chính hãng

        </div>

    </footer>


    <!-- JAVASCRIPT -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>